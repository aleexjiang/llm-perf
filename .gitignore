# 构建产物统一落 bin/，命名 bench-<os>-<arch>（见 Makefile）。
# 产物不入库（13M 二进制拖慢拉取），用 make 重建或向维护者索取。
bin/bench
bin/bench-*

output/
output-*/
# WorkBuddy 项目数据（记忆/日志/技能），不入库
.workbuddy/
.env
*.test
.DS_Store
configs/customer.yaml
CODEBUDDY.local.md
# 客户环境实测配置（含真实端点/密钥），只留本机
configs/customer-*.yaml
configs/customer-*.md
# 客户环境实测手册（含客户端点/key），放在 docs/ 也不入库
docs/customer-*.md

# 前缀缓存探针临时产物（能力已并入 bench probe --cache，不入库）
/testdata/
cache-probe-testdata.zip

# 降速熔断回归 harness 的运行日志（scripts/stall-e2e）
scripts/stall-e2e/reqs.log

# Python 字节码缓存（mock/桩脚本运行产物）
__pycache__/

# 真机测试工作空间（含实测配置/二进制/产物，整目录不入库）
/llm-perf-test/
